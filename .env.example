# Environment Variables Example for AI Virtual Wardrobe

# General
APP_ENV=development

# PostgreSQL Database
POSTGRES_DB=wardrobe
POSTGRES_USER=wardrobe_user
POSTGRES_PASSWORD=wardrobe_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wardrobe

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=wardrobe-storage
MINIO_REGION=us-east-1

# AI Service
AI_SERVICE_URL=http://localhost:8000
BACKEND_CALLBACK_URL=http://backend:8080/api/internal/try-ons/callback
INTERNAL_API_SECRET=dev_internal_secret_key_12345

# Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Daily Quota
DAILY_TRY_ON_QUOTA=5

